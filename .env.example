# Copy to .env and adjust as needed. docker-compose and the pipeline both
# read DATABASE_URL via src/data_proc/config.py (python-dotenv is not
# required; export these in your shell or source the file before running).

DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/data_processing_demo
ENRICHMENT_API_URL=https://jsonplaceholder.typicode.com/users
REQUEST_TIMEOUT_SECONDS=10
