# Copy to .env and adjust as needed. docker-compose and the pipeline both
# read these via src/data_proc/config.py, which auto-loads this file with
# python-dotenv — no need to manually export or source it.

# --- Database & API (match docker-compose.yml's Postgres defaults) ---
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/data_processing_demo
ENRICHMENT_API_URL=https://jsonplaceholder.typicode.com/users
REQUEST_TIMEOUT_SECONDS=10

# --- Data home (optional) ---
# Base directory that all relative data paths below resolve against.
# Defaults to the current working directory, so it normally does not need
# to be set when running `uv run python examples/run_*.py` from the repo
# root. Set this if you run the demos from a different working directory.
# DATA_PROC_HOME=/path/to/data-processing

# --- Individual data path overrides (optional) ---
# Each defaults to a path under DATA_PROC_HOME (or the cwd); override any
# of these independently if you want a non-default location.
CUSTOMERS_CSV=data/raw/customers.csv
ORDERS_CSV=data/raw/orders.csv
PROCESSED_DIR=data/processed

# Kappa demo: append-only event log + consumer checkpoint + order state.
KAPPA_EVENT_LOG=data/processed/kappa_events.jsonl
KAPPA_CHECKPOINT=data/processed/kappa_checkpoint.json
KAPPA_STATE_PATH=data/processed/kappa_order_state.json

# Lambda demo: speed-layer event log + batch layer's watermark.
LAMBDA_EVENT_LOG=data/processed/lambda_events.jsonl
LAMBDA_WATERMARK=data/processed/lambda_watermark.json

# Data Mesh demo: self-serve catalog both domains publish metadata into.
DATA_MESH_CATALOG=data/processed/data_mesh_catalog.json
